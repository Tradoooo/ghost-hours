{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "e2e/**/*.ts",
    "fixtures/*/index.ts",
    "fixtures/*/*.test.ts",
    "fixtures/*/*.d.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "fixtures/vibe-lab/**"]
}
